<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🖱️ WiFi Mouse"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="60dp"/>

    <Button
        android:id="@+id/btnServerMode"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="📱 Je suis l'appareil à CONTRÔLER"
        android:background="#2196F3"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btnClientMode"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="🎮 Je suis la SOURIS"
        android:background="#4CAF50"
        android:textColor="#FFFFFF"
        android:textSize="16sp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="\n⚠️ Les 2 appareils doivent être sur le MÊME WiFi"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginTop="40dp"/>

</LinearLayout>
