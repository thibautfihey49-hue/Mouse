<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bienvenue sur RemoteMouse"
        android:textSize="16sp"
        android:padding="12dp"
        android:background="#E8F5E9"
        android:textColor="#2E7D32"
        android:gravity="center"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📱 Mode Appareil Contrôlé :"
        android:textSize="14sp"
        android:layout_marginTop="16dp"
        android:textStyle="bold"/>

    <Button
        android:id="@+id/btnStartServer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="▶️ Démarrer le serveur"
        android:background="#4CAF50"
        android:textColor="#FFFFFF"
        android:layout_marginVertical="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📲 Mode Contrôleur :"
        android:textSize="14sp"
        android:layout_marginTop="16dp"
        android:textStyle="bold"/>

    <EditText
        android:id="@+id/etIp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Entrez l'IP de l'appareil contrôlé (ex: 192.168.1.10)"
        android:inputType="textUri"
        android:background="#FFFFFF"
        android:padding="12dp"/>

    <Button
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔌 Se connecter"
        android:background="#2196F3"
        android:textColor="#FFFFFF"
        android:layout_marginVertical="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🖱️ Pavé tactile (glissez pour déplacer le curseur)"
        android:textSize="14sp"
        android:layout_marginTop="16dp"/>

    <com.remotemouse.TouchpadView
        android:id="@+id/touchpad"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="#E0E0E0"
        android:layout_marginVertical="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnLeftClick"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="◀ Clic Gauche"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnRightClick"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Clic Droit ▶"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⌨️ Clavier distant"
        android:textSize="14sp"
        android:layout_marginTop="16dp"/>

    <EditText
        android:id="@+id/etKeyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Tapez votre texte ici..."
        android:inputType="textMultiLine"
        android:lines="2"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:layout_marginVertical="8dp"/>

    <Button
        android:id="@+id/btnSendText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📤 Envoyer le texte"
        android:background="#FF9800"
        android:textColor="#FFFFFF"/>

</LinearLayout>
