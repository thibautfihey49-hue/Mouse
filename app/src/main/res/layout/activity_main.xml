<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#F5F5F5">

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Prêt"
        android:textSize="16sp"
        android:padding="12dp"
        android:background="#E8F5E9"
        android:textColor="#2E7D32"/>

    <Button
        android:id="@+id/btnServer"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_below="@id/tvStatus"
        android:layout_marginTop="12dp"
        android:text="🔵 DÉMARRER LE SERVEUR"
        android:background="#2196F3"
        android:textColor="#FFFFFF"
        android:textSize="15sp"/>

    <Button
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_below="@id/btnServer"
        android:layout_marginTop="8dp"
        android:text="🟢 CHOISIR UN APPAREIL"
        android:background="#4CAF50"
        android:textColor="#FFFFFF"
        android:textSize="15sp"/>

    <Button
        android:id="@+id/btnDisconnect"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_below="@id/btnConnect"
        android:layout_marginTop="8dp"
        android:text="🔴 DÉCONNECTER"
        android:background="#F44336"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:enabled="false"/>

    <FrameLayout
        android:id="@+id/touchpad"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_below="@id/btnDisconnect"
        android:layout_marginTop="16dp"
        android:background="#FFFFFF"
        android:layout_marginBottom="16dp"
        android:enabled="false">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="🖱️ Déplacez votre doigt ici"
            android:gravity="center"
            android:textColor="#999999"
            android:textSize="16sp"/>

        <View
            android:id="@+id/cursor"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/cursor_shape"
            android:layout_gravity="top|left"
            android:translationX="270dp"
            android:translationY="135dp"/>
    </FrameLayout>

    <Button
        android:id="@+id/btnClick"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_below="@id/touchpad"
        android:text="👆 CLIC GAUCHE"
        android:background="#673AB7"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:enabled="false"/>

</RelativeLayout>
