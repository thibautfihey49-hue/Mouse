<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F8F9FA">

    <Button
        android:id="@+id/btnBackClient"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← Retour"
        android:background="#E5E7EB"
        android:textColor="#374151"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎮 SOURIS DISTANTE — Contrôle"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Adresse IP du serveur :"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#374151"/>

    <EditText
        android:id="@+id/etServerIp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="ex: 192.168.1.100"
        android:inputType="text"
        android:textSize="16sp"
        android:padding="14dp"
        android:background="#FFFFFF"
        android:layout_marginBottom="12dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1"
            android:text="🔌 CONNECTER"
            android:background="#16A34A"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:layout_marginEnd="6dp"
            android:elevation="2dp"/>

        <Button
            android:id="@+id/btnDisconnect"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1"
            android:text="🔌 DÉCONNECTER"
            android:background="#DC2626"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:layout_marginStart="6dp"
            android:enabled="false"
            android:elevation="2dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvClientStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="✅ Prêt — Entrez l'IP et connectez-vous"
        android:textSize="14sp"
        android:padding="12dp"
        android:background="#D1FAE5"
        android:textColor="#065F46"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🖱️ Pavé tactile — Déplacez votre doigt"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#4B5563"/>

    <View
        android:id="@+id/touchpad"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="#FFFFFF"
        android:layout_marginBottom="12dp"
        android:enabled="false"
        android:elevation="1dp"/>

    <Button
        android:id="@+id/btnLeftClick"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="👆 CLIC GAUCHE"
        android:background="#7C3AED"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:layout_marginBottom="16dp"
        android:enabled="false"
        android:elevation="2dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📊 Journal de connexion :"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#4B5563"/>

    <TextView
        android:id="@+id/tvClientLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text=""
        android:textSize="11sp"
        android:padding="10dp"
        android:background="#FFFFFF"
        android:textColor="#374151"
        android:fontFamily="monospace"
        android:scrollbars="vertical"/>

</LinearLayout>
