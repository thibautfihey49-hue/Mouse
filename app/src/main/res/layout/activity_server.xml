<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F8F9FA">

    <Button
        android:id="@+id/btnBackServer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← Retour"
        android:background="#E5E7EB"
        android:textColor="#374151"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📱 SERVEUR — Appareil contrôlé"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvServerIp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🌐 IP: ..."
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:background="#DBEAFE"
        android:textColor="#1E40AF"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/tvServerStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="✅ Prêt"
        android:textSize="15sp"
        android:padding="12dp"
        android:background="#D1FAE5"
        android:textColor="#065F46"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnStartServer"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:text="▶️ DÉMARRER LE SERVEUR"
        android:background="#2563EB"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:layout_marginBottom="16dp"
        android:elevation="2dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📋 Activité :"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#4B5563"/>

    <TextView
        android:id="@+id/tvServerLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text=""
        android:textSize="11sp"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:textColor="#374151"
        android:fontFamily="monospace"
        android:scrollbars="vertical"/>

</LinearLayout>
